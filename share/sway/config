# Panel mode and scale come from the installer.
include /etc/comet/sway-output.conf

set $mod Mod4
font "JetBrainsMono Nerd Font Mono" 12
default_border pixel 2
gaps inner 6
focus_follows_mouse no
floating_modifier $mod

client.focused #fabd2f #fabd2f #1d2021 #fabd2f
client.focused_inactive #3c3836 #1d2021 #928374 #3c3836
client.unfocused #3c3836 #1d2021 #928374 #3c3836
client.urgent #fb4934 #282828 #ebdbb2 #fb4934

input type:keyboard {
    xkb_layout us
    xkb_options caps:escape
}

input type:touchpad {
    dwt enabled
    tap enabled
    drag enabled
    natural_scroll enabled
    middle_emulation enabled
}

bindgesture swipe:3:up workspace prev
bindgesture swipe:3:down workspace next

bindsym $mod+Return exec footclient
bindsym $mod+space exec fuzzel
bindsym $mod+e exec comet-scratch scratch-yazi yazi
bindsym $mod+g exec comet-scratch scratch-lazygit lazygit
bindsym $mod+b exec vivaldi-stable
bindsym $mod+o layout toggle split tabbed stacking
bindsym $mod+w exec comet-wall pick
bindsym $mod+Escape exec swaylock -f
bindsym $mod+Shift+e exec comet-power
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+f fullscreen toggle
bindsym $mod+t layout toggle split tabbed
bindsym $mod+s layout stacking
bindsym $mod+minus move scratchpad
bindsym $mod+plus scratchpad show
bindsym $mod+Shift+space floating toggle
bindsym $mod+slash exec footclient --app-id comet-keys comet-keys

for_window [app_id="comet-keys"] floating enable, resize set 520 520, move position center
for_window [app_id="tui-float"] floating enable, resize set 900 700, move position center
for_window [app_id="scratch-yazi"] move scratchpad, scratchpad show
for_window [app_id="scratch-lazygit"] move scratchpad, scratchpad show

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+button1 move
bindsym $mod+button2 resize

bindsym $mod+Shift+s exec grim -g "$(slurp)" - | satty -f - --copy-command wl-copy
bindsym Print exec grim -g "$(slurp)" - | satty -f - --copy-command wl-copy
bindsym Shift+Print exec grim - | satty -f - --copy-command wl-copy

bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower

exec foot --server
exec waybar -c /usr/share/comet/waybar/keys.jsonc -s /usr/share/comet/waybar/keys.css
exec swayosd-server
exec comet-wall restore
exec mako -c /usr/share/comet/mako/config
exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
exec dbus-update-activation-environment --systemd --all
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec swayidle -w timeout 600 'swaylock -f' timeout 1200 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f'

bar {
    swaybar_command comet-waybar
}
