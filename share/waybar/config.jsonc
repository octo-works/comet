{
  "layer": "top",
  "position": "left",
  "margin": "6 0 6 6",
  "spacing": 6,
  "modules-left": ["custom/launcher", "sway/workspaces"],
  "modules-right": ["group/status", "group/controls", "clock"],
  "group/status": {
    "orientation": "inherit",
    "modules": ["network", "cpu", "memory", "temperature"]
  },
  "group/controls": {
    "orientation": "inherit",
    "modules": ["backlight", "pulseaudio", "battery"]
  },
  "custom/launcher": {
    "format": "󰘩",
    "on-click": "fuzzel",
    "on-click-right": "comet-power",
    "tooltip-format": "comet"
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} {ipaddr}",
    "tooltip-format-disconnected": "offline",
    "on-click": "footclient --app-id tui-float nmtui"
  },
  "cpu": {
    "format": "󰻠",
    "tooltip-format": "cpu {usage}%",
    "interval": 5,
    "on-click": "footclient btop"
  },
  "memory": {
    "format": "󰍛",
    "tooltip-format": "mem {percentage}%",
    "interval": 5,
    "on-click": "footclient btop"
  },
  "temperature": {
    "format": "󰔏",
    "tooltip-format": "{temperatureC}C",
    "critical-threshold": 90,
    "interval": 5
  },
  "backlight": {
    "format": "󰃟",
    "tooltip-format": "light {percent}%",
    "on-scroll-up": "swayosd-client --brightness raise",
    "on-scroll-down": "swayosd-client --brightness lower"
  },
  "pulseaudio": {
    "format": "󰕾",
    "format-muted": "󰖁",
    "tooltip-format": "vol {volume}%",
    "max-volume": 100,
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower"
  },
  "battery": {
    "interval": 30,
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%"
  },
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%A %d %B %Y}\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3
    },
    "interval": 30
  }
}
