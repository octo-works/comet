{
  "layer": "bottom",
  "position": "bottom",
  "exclusive": false,
  "passthrough": true,
  "margin-bottom": 8,
  "margin-right": 12,
  "modules-right": ["custom/keys"],
  "custom/keys": {
    "exec": "cat \"${HOME}/.config/comet/keys.txt\" 2>/dev/null || cat /usr/share/comet/waybar/keys.txt",
    "interval": 2,
    "tooltip": false
  }
}
