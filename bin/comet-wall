#!/bin/sh
# Pick or restore a static swaybg image. swaybg exits its work after the first frame.
dir=/usr/share/comet/walls
state=${XDG_STATE_HOME:-$HOME/.local/state}/comet/wallpaper
default=$dir/jack-dong-v-eJthc_z6c-unsplash-cropped.jpg

apply() {
  pkill -x swaybg 2>/dev/null || true
  swaybg -i "$1" -m fill >/dev/null 2>&1 &
}

restore() {
  path=$default
  if [ -f "$state" ]; then
    read -r path < "$state"
  fi
  [ -f "$path" ] || path=$default
  apply "$path"
}

pick() {
  mkdir -p "$(dirname "$state")"
  choice=$(find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -printf '%f\n' | sort | fuzzel --dmenu --prompt 'wall ')
  [ -n "$choice" ] || exit 0
  [ -f "$dir/$choice" ] || exit 1
  printf '%s\n' "$dir/$choice" > "$state"
  apply "$dir/$choice"
}

case ${1:-} in
  restore) restore ;;
  pick) pick ;;
  *) exit 1 ;;
esac
